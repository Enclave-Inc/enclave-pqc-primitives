{
  "id": "ENCLAVE_PQ_SUITE_v1",
  "version": 1,
  "description": "Approved post-quantum algorithm suite for Enclave product SDKs. Symmetric algorithms use 256-bit security targets suitable for PQ hybrid deployments.",
  "nist": {
    "kem": "FIPS 203 (ML-KEM)",
    "signature": "FIPS 204 (ML-DSA)",
    "symmetric": "FIPS 197 (AES) with SP 800-38D (GCM)",
    "hash": "FIPS 202 (SHA-3 family / SHAKE)"
  },
  "algorithms": {
    "kem": {
      "id": "ML-KEM-768",
      "parameterSet": "768",
      "deprecated": false
    },
    "signature": {
      "id": "ML-DSA-65",
      "parameterSet": "65",
      "deprecated": false
    },
    "symmetric": {
      "id": "AES-256-GCM",
      "keyBytes": 32,
      "ivBytes": 12,
      "deprecated": false
    },
    "hash": {
      "id": "SHAKE256",
      "defaultOutputBytes": 32,
      "deprecated": false
    }
  },
  "disallowedForNewCode": [
    "X25519",
    "Ed25519",
    "ECDSA",
    "RSA",
    "AES-128-GCM"
  ],
  "compositeLabels": {
    "documentEncryption": "AES-256-GCM+ML-KEM-768",
    "manifestSignature": "ML-DSA-65"
  }
}
